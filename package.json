{
  "name": "readwise",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run db:push && concurrently \"npm:dev:*\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "db:push": "prisma db push --schema=server/prisma/schema.prisma",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
